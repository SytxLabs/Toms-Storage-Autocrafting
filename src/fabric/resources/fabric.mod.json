{
  "schemaVersion": 1,
  "id": "tsautocraft",
  "version": "${version}",

  "name": "Tom's Storage Autocrafting",
  "description": "Unofficial AE2-style autocrafting for Tom's Simple Storage: Pattern Terminal, Pattern Provider, Autocrafting Terminal, Requester, Level Maintainer, Exporter, Importer, Crafting Emitter and Memory Card. Request crafts right in Tom's terminals, with a recipe tree, job priorities, fluids via containers, upgrades, Jade and an API for other mods.",
  "authors": [
    "SytxLabs"
  ],
  "contact": {
    "homepage": "https://sytxlabs.eu",
    "sources": "https://github.com/SytxLabs/Toms-Storage-Autocrafting",
    "issues": "https://github.com/SytxLabs/Toms-Storage-Autocrafting/issues",
    "modrinth": "https://modrinth.com/mod/toms-storage-autocrafting",
    "curseforge": "https://www.curseforge.com/minecraft/mc-mods/toms-storage-autocrafting"
  },

  "license": "MIT",
  "icon": "assets/tsautocraft/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "eu.sytxlabs.tsautocraft.fabric.TsAutocraftFabric"
    ],
    "client": [
      "eu.sytxlabs.tsautocraft.fabric.TsAutocraftFabricClient"
    ],
    "jei_mod_plugin": [
      "eu.sytxlabs.tsautocraft.compat.jei.TsAutocraftJeiPlugin"
    ],
    "rei_client": [
      "eu.sytxlabs.tsautocraft.compat.rei.TsAutocraftReiPlugin"
    ],
    "jade": [
      "eu.sytxlabs.tsautocraft.compat.jade.TsAutocraftJadePlugin"
    ],
    "modmenu": [
      "eu.sytxlabs.tsautocraft.compat.modmenu.TsAutocraftModMenu"
    ]
  },
  "mixins": [
    "tsautocraft.mixins.json",
    "tsautocraft.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "toms_storage": "${toms_storage}"
  },
  "suggests": {
    "jei": "*",
    "roughlyenoughitems": "*",
    "jade": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "toms_storage",
      "update_checker": true
    }
  }
}
